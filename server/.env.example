SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# auto = pick the newest available Claude at runtime (Opus first). Pin with a model id if you need one.
ANTHROPIC_MODEL=auto
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/oauth/google/callback
# Production Render (must match Google Cloud OAuth authorized redirect URI):
GOOGLE_REDIRECT_URI=https://rytsensetech-growth-board.onrender.com/api/oauth/google/callback
# Optional explicit properties (OAuth callback also auto-picks GSC site for the domain):
GSC_SITE_URL=https://rytsensetech.com/
GA4_PROPERTY_ID=properties/423166919
CRON_SECRET=
TEAM_USERNAME=rytsensetech
TEAM_PASSWORD=Admin@123#
TEAM_SESSION_MINUTES=30
# Local: http://localhost:8787  |  Production Pages:
PUBLIC_APP_URL=https://rytsensetech-growth-board.pages.dev
CLARITY_URL=https://clarity-copilot.rytsenselifestylellp.workers.dev/latest
PORT=8787

# Google PageSpeed Insights (Cloud Console > enable "PageSpeed Insights API" > create API key)
GOOGLE_PAGESPEED_API_KEY=
# Optional cap on weekly PSI pages (GSC + sitemap). Unset = scan every page.
# PSI_MAX_PAGES=5000

# Slack incoming webhook for new PSI dev tasks (optional; leave blank to skip)
SLACK_WEBHOOK_URL=
# Only honoured by legacy webhooks; app webhooks always post to the channel they were created for
SLACK_DEV_CHANNEL=#dev-alerts
