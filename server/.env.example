SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# auto = pick the newest available Claude at runtime (Opus first). Pin with a model id if you need one.
ANTHROPIC_MODEL=auto
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/oauth/google/callback
CRON_SECRET=
TEAM_USERNAME=rytsensetech
TEAM_PASSWORD=Admin@123#
TEAM_SESSION_MINUTES=30
PUBLIC_APP_URL=http://localhost:8787
CLARITY_URL=https://clarity-copilot.rytsenselifestylellp.workers.dev/latest
PORT=8787

# Google PageSpeed Insights (Cloud Console > enable "PageSpeed Insights API" > create API key)
GOOGLE_PAGESPEED_API_KEY=

# Slack incoming webhook for new PSI dev tasks (optional; leave blank to skip)
SLACK_WEBHOOK_URL=
# Only honoured by legacy webhooks; app webhooks always post to the channel they were created for
SLACK_DEV_CHANNEL=#dev-alerts
