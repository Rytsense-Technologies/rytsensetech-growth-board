# ---------------------------------------------------------------------------
# SEO agent team — configuration
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Live Google SERP access -----------------------------------------------
# Needed for real competitive analysis: positions, SERP features, AI Overview
# sources, featured snippet holders. Pick ONE provider.
#
# These are SERP APIs, not scrapers. Scraping google.com directly violates
# Google's ToS, triggers CAPTCHAs within a handful of queries, and produces
# unreliable data — so the team does not do it.
#
#   serper.dev    2,500 free queries, then ~$0.30/1k   <- cheapest, fastest
#                 NOTE: returns organic + PAA + related only. No AI Overview,
#                 no ad load. Fine for rankings and competitive position;
#                 NOT sufficient for AI Overview citation tracking.
#   serpapi.com   100 free/month,     then ~$50/5k     <- only one that returns
#                 AI Overview sources. Needed for the AEO track.
#   valueserp.com 100 free/month,     then ~$25/5k     <- AI Overview, no ads
#
# Setting more than one key is fine — SERP_PROVIDER picks which is used.
# A common setup: serper for bulk ranking work, serpapi for AEO spot-checks.
SERPER_API_KEY=
SERPAPI_API_KEY=
VALUESERP_API_KEY=

# auto = use whichever key is present (default)
SERP_PROVIDER=auto

# Cache SERP responses to avoid paying twice for the same query.
SERP_CACHE_TTL_HOURS=24

# Default search location for SERP calls. Rankings are location-dependent —
# set this to the market in your site profile.
SERP_DEFAULT_LOCATION=United States

# --- Optional: other data sources -------------------------------------------
# Google Search Console and GA4 are reached through MCP connectors, configured
# in Claude Code rather than here. See README "Connecting data sources".
