{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python tools/serp.py:*)",
      "Bash(python tools/memory.py:*)",
      "Bash(python tools/board.py:*)",
      "Bash(python3 tools/serp.py:*)",
      "Bash(python3 tools/memory.py:*)",
      "Bash(python3 tools/board.py:*)",
      "Bash(node tools/guard.mjs:*)",
      "Bash(node tools/apply-protocol.mjs:*)",
      "Bash(node evals/run.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/id_rsa)",
      "Read(./**/*.pem)",
      "Bash(curl:*|*sh)",
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/guard.mjs pre-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/guard.mjs post-write",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
