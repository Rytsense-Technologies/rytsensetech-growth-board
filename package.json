{
  "name": "rytsensetech-growth-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Live SEO & marketing dashboard for rytsensetech.com — data pulled from Search Console, GA4 and Clarity on a schedule via GitHub Actions, served as a static site on Vercel.",
  "scripts": {
    "fetch-data": "node scripts/fetch-data.mjs",
    "deploy:cf": "node scripts/deploy-cloudflare.mjs",
    "import:gsc-issues": "python scripts/import-gsc-issues.py",
    "import:product": "node scripts/import-product.mjs",
    "start": "node server/src/index.js",
    "api": "node server/src/index.js",
    "psi:weekly": "node scripts/psi-weekly.mjs",
    "test:product": "node --test server/test/scope.test.mjs server/test/psi.test.mjs server/test/jobs-model.test.mjs server/test/team-auth.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "express": "^5.1.0",
    "googleapis": "^140.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
